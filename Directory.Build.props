<!-- Directory.Build.props - Repository-wide MSBuild properties -->
<Project>
  <PropertyGroup>
    <!-- Enable code style rules in build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    <!-- Enable .NET analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    
    <!-- Use latest analysis level -->
    <AnalysisLevel>latest</AnalysisLevel>
    
    <!-- Make analyzers visible in build output -->
    <ReportAnalyzer>true</ReportAnalyzer>
    
    <!-- Generate additional code analysis logs -->
    <CodeAnalysisGenerateSuccessFile>true</CodeAnalysisGenerateSuccessFile>
    
    <!-- Optional: Treat warnings as errors (enable after cleanup) -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
    
    <!-- Warning level for C# compiler -->
    <WarningLevel>5</WarningLevel>
    
    <!-- Enable nullable reference types -->
    <Nullable>enable</Nullable>
    
    <!-- Implicit usings -->
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Suppress specific warnings that are from external dependencies or can't be auto-fixed -->
    <!-- CS0618: Obsolete warnings -->
    <!-- CA1031: Do not catch general exception types (requires manual review) -->
    <!-- CA1062: Validate arguments of public methods (requires null checks) -->
    <!-- CA1848: Use LoggerMessage delegates (performance optimization) -->
    <!-- CA2007: ConfigureAwait (not needed in ASP.NET Core) -->
    <!-- CA1051: Do not declare visible instance fields (requires property conversion) -->
    <!-- CA1716: Don't use reserved keywords (breaking change) -->
    <!-- CA2254: Logging template should not vary (requires refactoring) -->
    <!-- CA1000: Don't declare static members on generic types (design issue) -->
    <!-- CA1310: Specify StringComparison (requires manual fix) -->
    <!-- CA1866: Use char overload (performance) -->
    <!-- CA1805: Do not initialize unnecessarily (minor) -->
    <NoWarn>$(NoWarn);CS0618;CA1031;CA1062;CA1848;CA2007;CA1051;CA1716;CA2254;CA1000;CA1310;CA1866;CA1805</NoWarn>
    
    <!-- Enable documentation file generation for IDE0005 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- But suppress the XML documentation warnings -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  
  <!-- Common package references for analyzers (optional) -->
  <ItemGroup>
    <!-- Microsoft.CodeAnalysis.NetAnalyzers is included by default with .NET 5+ SDK -->
    <!-- Add additional analyzers here if needed -->
    <!-- <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.435">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference> -->
  </ItemGroup>
</Project>