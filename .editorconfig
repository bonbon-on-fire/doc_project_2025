# ============================================================================
# TEST-SPECIFIC RULES
# ============================================================================

# Test files - allow underscores in method names for better readability
[**/*Tests.cs]
# CA1707: Remove underscores from member names (allow for test methods)
dotnet_diagnostic.CA1707.severity = none

# ============================================================================
# STATIC FACTORY METHODS ON GENERIC TYPES
# ============================================================================

# Allow static factory methods on generic types (StateResult<T>.Success, StateOperation<T>.Create, etc.)
# These are legitimate API design patterns that improve usability
[**/StateManagement/**.cs]
# CA1000: Do not declare static members on generic types (allow for factory methods)
dotnet_diagnostic.CA1000.severity = none

# ============================================================================
# SUBMODULE WARNING SUPPRESSIONS
# ============================================================================
[submodules/**/*.cs]
# CS0618: Type or member is obsolete (can't modify submodules)
dotnet_diagnostic.CS0618.severity = none
# CS8602: Dereference of a possibly null reference (can't modify submodules)
dotnet_diagnostic.CS8602.severity = none

