{
  "dashboard": {
    "id": null,
    "title": "Orleans Grain Metrics",
    "tags": ["orleans", "metrics", "grains"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Active Grains by Type",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (grain_type) (orleans_grain_active_operations{grain_type=~\"UserGrain|ChatGrain|ModeGrain\"})",
            "legendFormat": "{{grain_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "basic"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "textMode": "auto"
        },
        "pluginVersion": "8.0.0",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Grain Activation Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(orleans_grain_activations_total[5m])",
            "legendFormat": "{{grain_type}} activations/sec"
          }
        ],
        "yAxes": [
          {
            "label": "Activations per second",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "xAxis": {
          "show": true
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "legend": {
          "show": true,
          "values": false,
          "min": false,
          "max": false,
          "current": false,
          "total": false,
          "avg": false
        }
      },
      {
        "id": 3,
        "title": "Grain Deactivation Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(orleans_grain_deactivations_total[5m])",
            "legendFormat": "{{grain_type}} deactivations/sec"
          }
        ],
        "yAxes": [
          {
            "label": "Deactivations per second",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "legend": {
          "show": true
        }
      },
      {
        "id": 4,
        "title": "Operation Latency (P95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(orleans_grain_operation_duration_seconds_bucket[5m]))",
            "legendFormat": "{{grain_type}}.{{operation_type}} P95"
          }
        ],
        "yAxes": [
          {
            "label": "Duration (seconds)",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "legend": {
          "show": true
        }
      },
      {
        "id": 5,
        "title": "Error Rate by Grain Type",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(orleans_grain_operation_errors_total[5m]) / rate(orleans_grain_operation_duration_seconds_count[5m]) * 100",
            "legendFormat": "{{grain_type}} error rate %"
          }
        ],
        "yAxes": [
          {
            "label": "Error rate (%)",
            "min": 0,
            "max": 100
          },
          {
            "show": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "legend": {
          "show": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "1m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "10s",
          "handler": 1,
          "name": "High Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 6,
        "title": "Grain State Size",
        "type": "graph",
        "targets": [
          {
            "expr": "orleans_grain_state_size_bytes",
            "legendFormat": "{{grain_type}} state size"
          }
        ],
        "yAxes": [
          {
            "label": "Size (bytes)",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "legend": {
          "show": true
        }
      },
      {
        "id": 7,
        "title": "Operation Throughput",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(orleans_grain_operation_duration_seconds_count[5m])",
            "legendFormat": "{{grain_type}}.{{operation_type}} ops/sec"
          }
        ],
        "yAxes": [
          {
            "label": "Operations per second",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "legend": {
          "show": true
        }
      },
      {
        "id": 8,
        "title": "User Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "orleans_grain_active_connections{grain_type=\"UserGrain\"}",
            "legendFormat": "Active connections"
          }
        ],
        "yAxes": [
          {
            "label": "Connections",
            "min": 0
          },
          {
            "show": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "legend": {
          "show": true
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          "datasource": "Prometheus",
          "definition": "label_values(orleans_grain_activations_total, grain_type)",
          "hide": 0,
          "includeAll": true,
          "label": "Grain Type",
          "multi": true,
          "name": "grain_type",
          "options": [],
          "query": "label_values(orleans_grain_activations_total, grain_type)",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "sort": 0,
          "tagValuesQuery": "",
          "tags": [],
          "tagsQuery": "",
          "type": "query",
          "useTags": false
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0,
    "links": []
  }
}