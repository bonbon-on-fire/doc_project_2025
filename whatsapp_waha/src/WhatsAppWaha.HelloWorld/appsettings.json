{
  "App": {
    "Name": "WhatsApp WAHA Hello World",
    "Version": "1.0.0",
    "Environment": "Development"
  },
  "Waha": {
    "Session": "default",
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000
  },
  "Ntfy": {
    "BaseUrl": "https://ntfy.sh",
    "MessagesTopic": "whatsapp-messages",
    "NotificationsTopic": "whatsapp-notifications",
    "PollingIntervalMs": 5000,
    "MaxMessagesPerPoll": 10,
    "TimeoutSeconds": 30,
    "AuthToken": "",
    "VerifySsl": true,
    "MaxProcessedMessageIds": 1000,
    "EnableFireAndForget": true
  },
  "Logging": {
    "ConsoleLogLevel": "Information",
    "FileLogLevel": "Warning",
    "FilePath": "logs/hello-world-.log"
  }
}