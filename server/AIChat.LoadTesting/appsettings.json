{
  "LoadTesting": {
    "ServerBaseUrl": "https://localhost:7152",
    "SignalRHubUrl": "/chatHub",
    "TestDurationSeconds": 600,
    "ReportingIntervalSeconds": 30,
    "MaxConcurrentUsers": 10000,
    "RampUpDurationSeconds": 300,
    "StableDurationSeconds": 600,
    "RampDownDurationSeconds": 60
  },
  "Scenarios": {
    "ConnectionLoad": {
      "Enabled": true,
      "MaxUsers": 10000,
      "RampUpSeconds": 300,
      "StableSeconds": 600,
      "ConnectionTimeoutSeconds": 30
    },
    "MessageLatency": {
      "Enabled": true,
      "MaxUsers": 1000,
      "MessagesPerSecond": 5,
      "TestDurationSeconds": 600,
      "MaxLatencyMs": 100
    },
    "GrainScaling": {
      "Enabled": true,
      "BurstUsers": [100, 500, 1000, 2500, 5000, 10000],
      "BurstDurationSeconds": 120,
      "RestDurationSeconds": 60
    },
    "BackgroundProcessing": {
      "Enabled": true,
      "MaxUsers": 500,
      "OperationsPerUser": 10,
      "ConcurrentOperations": 50
    },
    "MixedWorkload": {
      "Enabled": true,
      "ConnectionUsers": 5000,
      "ActiveUsers": 1000,
      "MessageRate": 2.0,
      "TestDurationSeconds": 1800
    },
    "EnduranceTest": {
      "Enabled": false,
      "MaxUsers": 5000,
      "TestDurationSeconds": 7200,
      "MessageRate": 0.5
    },
    "SseConnectionLoad": {
      "Enabled": true,
      "MaxConnections": 1500,
      "RampUpSeconds": 120,
      "StableSeconds": 300,
      "ConnectionTimeoutMs": 5000,
      "ReconnectDelayMs": 1000,
      "SseEndpoint": "/api/sse/stream"
    },
    "SseStreaming": {
      "Enabled": true,
      "ConnectionCount": 1000,
      "TestDurationSeconds": 600,
      "ChunkSizeBytes": 1024,
      "ChunksPerSecond": 10.0,
      "BufferSizeKB": 64
    },
    "SseRecovery": {
      "Enabled": false,
      "ConnectionCount": 500,
      "DropConnectionEverySeconds": 30,
      "MaxReconnectAttempts": 5,
      "ReconnectBackoffMs": 1000,
      "TestBufferOverflow": true
    },
    "SseMixedLoad": {
      "Enabled": false,
      "FastConsumers": 400,
      "NormalConsumers": 600,
      "SlowConsumers": 250,
      "TestDurationSeconds": 1200,
      "ConnectionChurnRate": 0.1,
      "MaxBufferedChunks": 100
    }
  },
  "Monitoring": {
    "CollectSystemMetrics": true,
    "MetricsIntervalSeconds": 10,
    "MonitorOrleansGrains": true,
    "MonitoringApiUrl": "/api/monitoring"
  },
  "Validation": {
    "MaxAllowedLatencyMs": 100,
    "MaxAllowedErrorRate": 0.05,
    "MinConnectionSuccessRate": 0.99,
    "MaxMemoryUsageMB": 8192,
    "MaxCpuUsagePercent": 80
  },
  "Orleans": {
    "ClusterId": "dev",
    "ServiceId": "AIChat.LoadTesting",
    "Endpoints": [
      "localhost:11111"
    ]
  },
  "Sse": {
    "BaseEndpoint": "/api/sse",
    "StreamEndpoint": "/api/sse/stream",
    "MonitoringEndpoint": "/api/monitoring/sse",
    "DefaultTimeoutMs": 30000,
    "BufferSizeKB": 64,
    "EnableCompression": true,
    "EnableAutoReconnect": true,
    "MaxReconnectAttempts": 5,
    "ReconnectBackoffMs": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.AspNetCore.SignalR": "Debug",
      "NBomber": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
    }
  }
}