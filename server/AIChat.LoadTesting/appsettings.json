{
  "LoadTesting": {
    "ServerBaseUrl": "https://localhost:7152",
    "SignalRHubUrl": "/chatHub",
    "TestDurationSeconds": 600,
    "ReportingIntervalSeconds": 30,
    "MaxConcurrentUsers": 10000,
    "RampUpDurationSeconds": 300,
    "StableDurationSeconds": 600,
    "RampDownDurationSeconds": 60
  },
  "Scenarios": {
    "ConnectionLoad": {
      "Enabled": true,
      "MaxUsers": 10000,
      "RampUpSeconds": 300,
      "StableSeconds": 600,
      "ConnectionTimeoutSeconds": 30
    },
    "MessageLatency": {
      "Enabled": true,
      "MaxUsers": 1000,
      "MessagesPerSecond": 5,
      "TestDurationSeconds": 600,
      "MaxLatencyMs": 100
    },
    "GrainScaling": {
      "Enabled": true,
      "BurstUsers": [100, 500, 1000, 2500, 5000, 10000],
      "BurstDurationSeconds": 120,
      "RestDurationSeconds": 60
    },
    "BackgroundProcessing": {
      "Enabled": true,
      "MaxUsers": 500,
      "OperationsPerUser": 10,
      "ConcurrentOperations": 50
    },
    "MixedWorkload": {
      "Enabled": true,
      "ConnectionUsers": 5000,
      "ActiveUsers": 1000,
      "MessageRate": 2.0,
      "TestDurationSeconds": 1800
    },
    "EnduranceTest": {
      "Enabled": false,
      "MaxUsers": 5000,
      "TestDurationSeconds": 7200,
      "MessageRate": 0.5
    }
  },
  "Monitoring": {
    "CollectSystemMetrics": true,
    "MetricsIntervalSeconds": 10,
    "MonitorOrleansGrains": true,
    "MonitoringApiUrl": "/api/monitoring"
  },
  "Validation": {
    "MaxAllowedLatencyMs": 100,
    "MaxAllowedErrorRate": 0.05,
    "MinConnectionSuccessRate": 0.99,
    "MaxMemoryUsageMB": 8192,
    "MaxCpuUsagePercent": 80
  },
  "Orleans": {
    "ClusterId": "dev",
    "ServiceId": "AIChat.LoadTesting",
    "Endpoints": [
      "localhost:11111"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.AspNetCore.SignalR": "Debug",
      "NBomber": "Information"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
    }
  }
}