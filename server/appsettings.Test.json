{
  "Urls": "http://localhost:5099",
  "LlmCache": {
    "EnableCaching": false
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff 'UTC' "
      }
    },
    "File": {
      "Path": "logs/server/app-test.jsonl",
      "JsonFormatter": {
        "UseUtcTimestamp": true,
        "IncludeScopes": true,
        "IncludeEventId": true,
        "IncludeCategory": true,
        "IncludeLogLevel": true
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=aichat_test.db"
  },
  "FeatureManagement": {
    "OrleansIntegration": {
      "EnabledFor": []
    }
  },
  "Orleans": {
    "ClusterId": "doc-chat-test-cluster",
    "ServiceId": "doc-chat-test-service",
    "GatewayPort": 30000,
    "DisableInTests": true
  },
  "SignalR": {
    "HubOptions": {
      "ClientTimeoutInterval": "00:05:00",
      "KeepAliveInterval": "00:02:00",
      "EnableDetailedErrors": true,
      "MaximumReceiveMessageSize": 32768,
      "StreamBufferCapacity": 10
    },
    "Transport": {
      "WebSockets": {
        "Enabled": true,
        "CloseTimeout": "00:00:02"
      },
      "ServerSentEvents": {
        "Enabled": true
      },
      "LongPolling": {
        "Enabled": true,
        "PollTimeout": "00:00:30"
      }
    }
  },
  "Mcp": {
    "ToolFiltering": {
      "EnableFiltering": true,
      "UsePrefixOnlyForCollisions": true,
      "GlobalAllowedTools": [
        "search",
        "fetch_*",
        "test_*"
      ],
      "GlobalBlockedTools": [
        "dangerous_tool"
      ]
    },
    "McpServers": {
      "test-sequential-thinking": {
        "Type": "stdio",
        "Command": "npx",
        "Args": ["-y", "mcp-sequentialthinking-tools"],
        "Description": "Sequential thinking tools for testing",
        "Enabled": false,
        "Priority": 1
      },
      "test-server-1": {
        "Type": "stdio",
        "Command": "mock-server",
        "Args": ["--tools", "search,fetch_url,process_data"],
        "Description": "Test server 1 with common tool names (collision scenario)",
        "Enabled": false,
        "Priority": 2,
        "AllowedTools": ["search", "fetch_url"],
        "BlockedTools": ["process_data"]
      },
      "test-server-2": {
        "Type": "stdio",
        "Command": "mock-server",
        "Args": ["--tools", "search,analyze,process_data"],
        "Description": "Test server 2 with overlapping tool names (collision scenario)",
        "Enabled": false,
        "Priority": 3
      }
    }
  }
}
