<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <UserSecretsId>16d0d730-3c71-4ed2-9e03-b9c8a40204bc</UserSecretsId>
    <!-- Treat warnings as errors to maintain code quality -->
    <!-- Temporarily disabled until all code style issues are fixed -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
    <WarningLevel>5</WarningLevel>
    <!-- Optionally suppress specific warnings that are from external dependencies -->
    <NoWarn>CS0618</NoWarn>
    <!-- Suppress obsolete warnings from submodules -->
  </PropertyGroup>
  <!-- Standard package references -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.6" />
    <!-- SignalR is included in ASP.NET Core 9.0 framework - no separate package needed -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.7" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Lib.AspNetCore.ServerSentEvents" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <!-- Orleans client integration -->
  <ItemGroup>
    <ProjectReference Include="..\AIChat.Orleans.Client\AIChat.Orleans.Client.csproj" />
  </ItemGroup>
  <!-- Feature Management for Orleans integration -->
  <ItemGroup>
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="3.0.0" />
  </ItemGroup>

  <!-- OpenTelemetry for distributed tracing -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />
  </ItemGroup>
  <!-- Conditional references for LmDotnetTools: use local projects if available, otherwise NuGet packages -->
  <ItemGroup Condition="Exists('../submodules/LmDotnetTools/src/LmCore/AchieveAi.LmDotnetTools.LmCore.csproj')">
    <ProjectReference Include="../submodules/LmDotnetTools/src/LmCore/AchieveAi.LmDotnetTools.LmCore.csproj" />
    <ProjectReference Include="../submodules/LmDotnetTools/src/Misc/AchieveAi.LmDotnetTools.Misc.csproj" />
    <ProjectReference
      Include="../submodules/LmDotnetTools/src/McpMiddleware/AchieveAi.LmDotnetTools.McpMiddleware.csproj" />
    <ProjectReference
      Include="../submodules/LmDotnetTools/src/OpenAiProvider/AchieveAi.LmDotnetTools.OpenAiProvider.csproj" />
    <ProjectReference Include="../submodules/LmDotnetTools/src/LmConfig/AchieveAi.LmDotnetTools.LmConfig.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../submodules/LmDotnetTools/src/LmCore/AchieveAi.LmDotnetTools.LmCore.csproj')">
    <PackageReference Include="AchieveAi.LmDotnetTools.LmCore" Version="1.0.20" />
    <PackageReference Include="AchieveAi.LmDotnetTools.Misc" Version="1.0.20" />
    <PackageReference Include="AchieveAi.LmDotnetTools.McpMiddleware" Version="1.0.20" />
    <PackageReference Include="AchieveAi.LmDotnetTools.OpenAiProvider" Version="1.0.20" />
    <PackageReference Include="AchieveAi.LmDotnetTools.LmConfig" Version="1.0.20" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Include Agent Card files -->
  <ItemGroup>
    <Content Include="..\agents\**\*.agent.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>agents\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
