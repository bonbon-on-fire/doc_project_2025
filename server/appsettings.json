                }
              },
              {
                "name": "NovitaAI",
                "model_name": "moonshotai/kimi-k2-instruct",
                "priority": 4,
                "pricing": {
                  "prompt_per_million": 0.57,
                  "completion_per_million": 2.3
                }
              },
              {
                "name": "Baseten",
                "model_name": "moonshotai/Kimi-K2-Instruct",
                "priority": 5,
                "pricing": {
                  "prompt_per_million": 0.6,
                  "completion_per_million": 2.5
                }
              },
              {
                "name": "Moonshot AI",
                "model_name": "kimi-k2-0711-preview",
                "priority": 6,
                "pricing": {
                  "prompt_per_million": 0.6,
                  "completion_per_million": 2.5
                }
              },
              {
                "name": "Together",
                "model_name": "moonshotai/Kimi-K2-Instruct",
                "priority": 7,
                "pricing": {
