{
  "ServicePorts": {
    "ApiServer": {
      "Development": 5130,
      "Test": 5099,
      "Production": 80
    },
    "OrleansHost": {
      "Http": {
        "Development": 55501,
        "Test": 55501,
        "Production": 443
      },
      "Gateway": {
        "Development": 30000,
        "Test": 30000,
        "Production": 30000
      }
    },
    "Client": {
      "Development": 5173,
      "Test": 5173,
      "Production": 443
    }
  },
  "Serilog": {
    "EnableSeq": true,
    "SeqServerUrl": "http://localhost:5341",
    "SeqApiKey": null,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "AIChat.Server": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AIChat.Server": "Information"
    },
    "File": {
      "Path": "../logs/server/app.jsonl",
      "JsonFormatter": {
        "UseUtcTimestamp": true,
        "IncludeScopes": true,
        "IncludeEventId": true,
        "IncludeCategory": true,
        "IncludeLogLevel": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=aichat.db"
  },
  "MemoryStateCache": {
    "DefaultSlidingExpirationMinutes": 30,
    "MemoryEstimationSampleSize": 10,
    "FallbackMemoryEstimationBytes": 512,
    "ObjectOverheadFactor": 1.4,
    "BaseObjectOverheadBytes": 64,
    "MaxDegreeOfParallelism": 0,
    "EnableDetailedLogging": true,
    "EnableMetricsCollection": true,
    "EnableKeyTrackerCleanup": true
  },
  "ResponseCache": {
    "CompressionThresholdBytes": 1024,
    "MinimumCompressionRatio": 0.8,
    "HealthCheckTimeoutMs": 5000,
    "MinimumHitRatio": 0.3,
    "TargetHitRatio": 0.5,
    "MemoryWarningThresholdPercent": 75.0,
    "MemoryCriticalThresholdPercent": 90.0,
    "MaxAcceptableLatencyMs": 10.0,
    "MemoryBudgetBytes": 104857600,
    "CleanupIntervalMinutes": 5,
    "StaleMetricsCutoffHours": 1,
    "EnableCompression": true,
    "EnableMaintenance": true,
    "EnableDetailedHealthChecks": true,
    "EnableDetailedMetrics": true,
    "EnableCacheWarmup": true
  },
  "Orleans": {
    "ClusterId": "doc-chat-cluster",
    "ServiceId": "doc-chat-service",
    "GatewayPort": 30000
  },
  "OrleansResilience": {
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "SamplingDurationSeconds": 60,
      "MinimumThroughput": 10,
      "BreakDurationSeconds": 30,
      "Enabled": true
    },
    "RetryPolicy": {
      "MaxRetryAttempts": 3,
      "BaseDelayMilliseconds": 100,
      "MaxDelayMilliseconds": 10000,
      "UseJitter": true,
      "Enabled": true,
      "RetryableExceptions": [
        "Orleans.Runtime.OrleansMessageRejectionException",
        "System.TimeoutException",
        "System.Net.Http.HttpRequestException"
      ]
    },
    "Timeout": {
      "DefaultTimeoutSeconds": 30,
      "HealthCheckTimeoutSeconds": 5,
      "StateRetrievalTimeoutSeconds": 10,
      "Enabled": true
    },
    "Bulkhead": {
      "MaxConcurrency": 20,
      "MaxQueuedItems": 50,
      "Enabled": true
    }
  },
  "BackgroundProcessing": {
    "OperationTimeout": "00:05:00",
    "MaxConcurrentOperations": 5,
    "QueueCapacity": 1000,
    "RetryPolicy": {
      "MaxRetries": 3,
      "RetryDelayMilliseconds": 1000,
      "BackoffMultiplier": 2.0
    },
    "Monitoring": {
      "MetricsUpdateInterval": "00:01:00",
      "OperationHistoryRetention": "01:00:00",
      "EnableDetailedLogging": false
    },
    "Fallback": {
      "EnableAutoFallback": true,
      "FallbackTimeoutMilliseconds": 2000,
      "MaxConsecutiveFailures": 3
    }
  },
  "OrleansGrains": {
    "UserGrain": {
      "MaxActivityBufferSize": 100,
      "CleanupIntervalMinutes": 5,
      "MetricsUpdateIntervalMinutes": 1,
      "ActivityRetentionHours": 1.0,
      "CompletedOperationRetentionMinutes": 30,
      "EnablePeriodicTimers": true,
      "MessageBufferSizePerChat": 100,
      "MessageBufferTtlMinutes": 60,
      "BufferCleanupIntervalMinutes": 5,
      "BufferOverflowStrategy": "DropOldest",
      "MaxBufferDeliveryAttempts": 3
    },
    "Connections": {
      "StaleConnectionThresholdMinutes": 30,
      "ReconnectionGracePeriodMinutes": 5,
      "MaxConnectionsPerUser": 10
    },
    "Persistence": {
      "ActivityPersistenceInterval": 10,
      "MessagePersistenceInterval": 10,
      "StreamChunkPersistenceInterval": 100,
      "PersistOnDeactivation": true,
      "MaxPersistenceRetries": 3,
      "PersistenceRetryDelayMilliseconds": 100
    }
  },
  "Streaming": {
    "BufferSize": 100,
    "BackpressureThreshold": 80.0,
    "WriteTimeoutMs": 30000,
    "BackpressureDelayMs": 100,
    "EnableAdaptiveBackpressure": true,
    "EnableTelemetry": true,
    "MaxChunkSize": 32768,
    "FlushIntervalMs": 100,
    "EnableAutoRetry": true,
    "MaxRetryAttempts": 3,
    "AdaptiveBuffering": {
      "Enabled": true,
      "MinSize": 50,
      "MaxSize": 1000,
      "ScaleUpThreshold": 80.0,
      "ScaleDownThreshold": 30.0,
      "WindowSizeMinutes": 5,
      "ScaleFactor": 1.5,
      "ScaleCooldownSeconds": 30
    },
    "OverflowStrategy": {
      "Primary": "Backpressure",
      "Fallback": "DropOldest",
      "DropThreshold": 95.0,
      "EnableMetrics": true,
      "MaxDropBatchSize": 10
    },
    "Recovery": {
      "EnableAutoReconnect": true,
      "MaxReconnectAttempts": 5,
      "ReconnectDelayMs": 1000,
      "MaxReconnectDelayMs": 30000,
      "BackoffMultiplier": 2.0,
      "EnableMessageReplay": true,
      "ReplayBufferSize": 100,
      "ReplayMaxAgeSeconds": 300,
      "EnableCheckpoints": true,
      "CheckpointInterval": 50,
      "RecoveryTimeoutMs": 60000
    }
  },
  "ResilientStreaming": {
    "Enabled": true,
    "Reconnection": {
      "MaxAttempts": 5,
      "InitialDelayMs": 1000,
      "MaxDelayMs": 32000,
      "JitterMs": 500,
      "UseExponentialBackoff": true
    },
    "Buffer": {
      "Size": 1000,
      "TTLMinutes": 5,
      "HighPrioritySize": 100,
      "OverflowStrategy": "DropOldest"
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "FailureWindowSeconds": 60,
      "RecoveryTimeoutSeconds": 30,
      "SuccessThreshold": 3,
      "UseFallback": true
    },
    "PartialRecovery": {
      "Enabled": true,
      "MaxPartialMessages": 10,
      "ChunkTimeoutSeconds": 30,
      "EnableDeduplication": true,
      "MaxStorageSizeKb": 1000
    },
    "HealthCheck": {
      "Enabled": true,
      "EndpointPath": "/api/health/streaming",
      "CheckIntervalSeconds": 30,
      "IncludeDetailedMetrics": true
    }
  },
  "SignalR": {
    "HubOptions": {
      "ClientTimeoutInterval": "00:10:00",
      "KeepAliveInterval": "00:04:00",
      "EnableDetailedErrors": false,
      "MaximumReceiveMessageSize": 32768,
      "StreamBufferCapacity": 10
    },
    "Transport": {
      "WebSockets": {
        "Enabled": true,
        "CloseTimeout": "00:00:05"
      },
      "ServerSentEvents": {
        "Enabled": true
      },
      "LongPolling": {
        "Enabled": true,
        "PollTimeout": "00:01:30"
      }
    },
    "StickySessions": {
      "Enabled": true,
      "SessionIdHeader": "X-SignalR-SessionId"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "AIChat.Server",
    "ServiceVersion": "1.0.0",
    "Tracing": {
      "Enabled": true,
      "SamplingRatio": 1.0,
      "Sources": [
        "AIChat.Orleans"
      ]
    },
    "Otlp": {
      "Endpoint": "",
      "Headers": {}
    },
    "Console": {
      "Enabled": true,
      "ExportProcessorType": "Simple"
    }
  },
  "FeatureManagement": {
    "BackgroundProcessing": {
      "EnabledFor": [
        {
          "Name": "Percentage",
          "Parameters": {
            "Value": 0
          }
        }
      ]
    },
    "SignalRMessaging": {
      "EnabledFor": [
        {
          "Name": "Percentage",
          "Parameters": {
            "Value": 100
          }
        }
      ]
    },
    "ResilientStreaming": {
      "EnabledFor": [
        {
          "Name": "Percentage",
          "Parameters": {
            "Value": 0
          }
        }
      ]
    }
  },
  "AI": {
    "ModelId": "openai/gpt-5-mini"
  },
  "Mcp": {
    /* Function Filtering Configuration (Optional)
    "FunctionFiltering": {
      "EnableFiltering": false,              // Enable/disable function filtering globally
      "UsePrefixOnlyForCollisions": true,    // When true: only functions with name collisions get provider prefixes
                                              // When false: all functions get provider prefixes
      "GlobalAllowedFunctions": [            // Optional: Global whitelist (supports wildcards)
        "search_web",                        // Allow specific function
        "fetch_url",
        "github__*",                         // Allow all functions starting with "github__"
        "*_search"                           // Allow all functions ending with "_search"
      ],
      "GlobalBlockedFunctions": [            // Optional: Global blacklist (higher priority than allowed)
        "delete_file",                       // Block specific dangerous functions
        "execute_*"                          // Block all functions starting with "execute_"
      ]
    },
    */
    "McpServers": {
      "web-search": {
        "Type": "stdio",
        "Command": "npx",
        "Args": [
          "-y",
          "@marcopesani/mcp-server-serper"
        ],
        "Env": {
          "BRAVE_API_KEY": "${SERPER_API_KEY}"
        },
        "Description": "Search web through serper APIs",
        "Enabled": true,
        "Priority": 1
        /* Per-server tool filtering (Optional)
        ,
        "AllowedTools": [                    // Server-specific whitelist (overrides global)
          "search_web",                      // Only allow web search from this server
          "search_images"
        ],
        "BlockedTools": [                    // Server-specific blacklist (highest priority)
          "search_news"                      // Block news search from this server
        ]
        */
      },
      "webpage-fetch": {
        "Type": "stdio",
        "Command": "node",
        "Args": [
          "b:/sources/turndown-mcp/dist/server.js"
        ],
        "Description": "Webpage fetch MCP server for converting web pages to markdown",
        "Enabled": true,
        "Priority": 1
      },
      "filesystem": {
        "Type": "stdio",
        "Command": "npx",
        "Args": [
          "-y",
          "@modelcontextprotocol/server-filesystem"
        ],
        "Env": {
          "WORKSPACE_DIR": "${WORKSPACE_DIR:-./workspace}"
        },
        "Description": "NPM-based file system operations MCP server",
        "Enabled": false,
        "Priority": 3
      },
      "weather": {
        "Type": "stdio",
        "Command": "npx",
        "Args": [
          "-y",
          "mohaimen-weather-mcp"
        ],
        "Env": {
          "OPENWEATHER_API_KEY": "${OPENWEATHER_API_KEY}"
        },
        "Description": "Enhanced weather MCP server with forecasts, air quality, UV index",
        "Enabled": false,
        "Priority": 4
      },
      "sequential-thinking": {
        "Type": "stdio",
        "Command": "npx",
        "Args": [
          "-y",
          "mcp-sequentialthinking-tools"
        ],
        "Description": "Sequential thinking tools for step-by-step problem solving",
        "Enabled": false,
        "Priority": 5
      }
    },
    "Inputs": [
      {
        "Type": "promptString",
        "Id": "weather-api-key",
        "Description": "OpenWeather API Key",
        "Password": true,
        "DefaultValue": "OPENWEATHER_API_KEY"
      }
    ]
  },
  "ProductionMonitoring": {
    "MetricsCollectionIntervalSeconds": 30,
    "AlertCheckIntervalMinutes": 1,
    "MetricsRetentionHours": 24,
    "AlertRules": [
      {
        "Name": "Orleans Silo Down",
        "Description": "Alert when Orleans silo is not responding",
        "MetricName": "orleans.silo.healthy",
        "Condition": "unhealthy",
        "Severity": "critical",
        "ThresholdMinutes": 2,
        "NotificationChannels": [
          "operations",
          "development"
        ]
      },
      {
        "Name": "High Memory Usage",
        "Description": "Alert when memory usage exceeds threshold",
        "MetricName": "system.memory.working_set_mb",
        "Condition": "percentage > 1024",
        "Severity": "warning",
        "ThresholdMinutes": 3,
        "NotificationChannels": [
          "operations"
        ]
      },
      {
        "Name": "High Error Rate",
        "Description": "Alert when error rate is high",
        "MetricName": "errors.total",
        "Condition": "percentage > 5",
        "Severity": "warning",
        "ThresholdMinutes": 5,
        "NotificationChannels": [
          "development",
          "operations"
        ]
      },
      {
        "Name": "Background Queue Overload",
        "Description": "Alert when background queue depth is too high",
        "MetricName": "background.queue.depth",
        "Condition": "average > 100",
        "Severity": "warning",
        "ThresholdMinutes": 3,
        "NotificationChannels": [
          "development"
        ]
      }
    ]
  },
  "LmConfig": {
    "ApiKeyEnvironmentVariable": "LLM_API_KEY",
    "Models": [
