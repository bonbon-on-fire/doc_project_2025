{
  "Serilog": {
    "EnableSeq": true,
    "SeqServerUrl": "http://localhost:5341",
    "SeqApiKey": null,
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "AIChat.Server": "Debug"
      }
    }
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff 'UTC' "
      }
    },
    "File": {
      "Path": "logs/server/app-dev.jsonl",
      "JsonFormatter": {
        "UseUtcTimestamp": true,
        "IncludeScopes": true,
        "IncludeEventId": true,
        "IncludeCategory": true,
        "IncludeLogLevel": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AIChat.Server": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=aichat_dev.db"
  },
  "SignalR": {
    "HubOptions": {
      "EnableDetailedErrors": true,
      "MaximumReceiveMessageSize": 65536,
      "StreamBufferCapacity": 20
    }
  },
  "FeatureManagement": {
    "OrleansIntegration": {
      "EnabledFor": [
        {
          "Name": "AlwaysOn"
        }
      ]
    }
  }
}
